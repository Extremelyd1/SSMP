<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
        <add key="Unity" value="https://unity.bepinex.dev/nuget/v3/index.json" />
        <add key="silksong-modding" value="https://git.silksong-modding.org/api/packages/silksong-modding/nuget/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
            <package pattern="Silksong.*" />
        </packageSource>
        <packageSource key="BepInEx">
            <package pattern="BepInEx.*" />
            <package pattern="UnityEngine.Modules" />
        </packageSource>
        <packageSource key="silksong-modding">
            <package pattern="Silksong.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
